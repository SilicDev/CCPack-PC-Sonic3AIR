global s16 blizzard_x_pos = 0
global s16 blizzard_y_pos = 0

//# address-hook(0x00db44) end(0x00dbb2)
function void RenderHUD()
{
    CC_BlizzardEffect.render()
    base.RenderHUD()
}

function void CC_BlizzardEffect.render()
{
    if (!CC_BlizzardEffect.active())
    {
        return
    }

    u16 renderQueue = 0xcfff
    float opacity = CC_BlizzardEffect.opacity()

    blizzard_x_pos -= 9
    blizzard_y_pos += 3

    s16 x = (blizzard_x_pos - camera.position.x.u16) % 256
    s16 y = (blizzard_y_pos - camera.position.y.u16) % 256

    if ((2 + water.height.current) > camera.position.y.u16 || !level.water_present)
    {
        if (level.water_present)
        {
            Renderer.setViewport(0, 0, getScreenWidth(), water.height.current - camera.position.y.u16 + 2, renderQueue)
        }
        string key = global.zone == 0x05 ? "blizzard" : "blizzard_component"

        SpriteHandle blizzard = Renderer.addSpriteHandle(key, x, y, renderQueue + 2)
        blizzard.setPriorityFlag(1)
        blizzard.setPaletteOffset(0x20)
        blizzard.setOpacity(opacity)

        if (level.water_present)
        {
            Renderer.resetViewport(renderQueue + 2)
        }
    }
    SpriteHandle blizzardoverlay = Renderer.addSpriteHandle("snow_overlay", 0, 0, 0xa001)
    blizzardoverlay.setPriorityFlag(1)
    blizzardoverlay.setScale(2, 1)
}


// helper stuff
function bool CC_BlizzardEffect.active()
{
    return blizzard_timer > 0
}

function float CC_BlizzardEffect.opacity()
{
    return CC_WeatherEffect.opacity(blizzard_timer, BLIZZARD_DURATION)
}

function bool CC_BlizzardEffect.playerAboveWater()
{
    if (!level.water_present)
    {
        return true
    }

    return u16[0xffffb000 + 0x14] < water.height.current
}

function void CC_BlizzardEffect.refreshP1Physics()
{
    u32 oldA0 = A0
    u32 oldA4 = A4

    A0 = 0xffffb000
    A4 = addressof(global.move.speedcap)
    setSpeedCapProperties(A4)

    A0 = oldA0
    A4 = oldA4
}

function void CC_BlizzardEffect.start()
{
    blizzard_timer = BLIZZARD_DURATION
    CC_BlizzardEffect.refreshP1Physics()
}

function void CC_BlizzardEffect.update()
{
    if (blizzard_timer == 0)
    {
        return
    }

    --blizzard_timer

    if (blizzard_timer == 0)
    {
        CC_BlizzardEffect.refreshP1Physics()
    }
}

// override base game speed cap settings for icy floor
function void setSpeedCapProperties(u32 address)
{
    base.setSpeedCapProperties(address)
    CC_BlizzardEffect.applyIcePhysics(address)
}
function void setSpeedCapProperties(u32 address, bool isSuperActive)
{
    base.setSpeedCapProperties(address, isSuperActive)
    CC_BlizzardEffect.applyIcePhysics(address)
}
function void CC_BlizzardEffect.applyIcePhysics(u32 address)
{
    if (!CC_BlizzardEffect.active())
    {
        return
    }
    if (!CC_BlizzardEffect.playerAboveWater())
    {
        return
    }
    u16[address + 2] = max((u16[address + 2] * 3) >> 2, 1) // 75% accel
    u16[address + 4] = max(u16[address + 4] >> 2, 1) // 25% braking
}
//# address-hook(0x0338c4) end(0x033abe)
function void fn0338c4()
{
    u8 bit = (1 << D6.u8)

    if ((objA0.flags2a & bit) == 0)
    {
        if ((u8[A1 + 0x2a] & char.flag.ON_OBJECT) && u16[A1 + 0x42] != A0.u16)
        {
            u8[A2 + 0x01] = 0x02
            u8[A1 + 0x2e] &= ~(control_flag.DISABLE_WALLS | control_flag.DISABLE_ANIMATION)
            return
        }
    }
    base.fn0338c4()
}